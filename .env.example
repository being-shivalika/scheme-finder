# Server
PORT=5000
NODE_ENV=development

# Required for auth (any long random string). Required in production.
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/scheme-setu

# Comma-separated browser origins allowed by CORS (credentials enabled)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Gemini chat assistant (server-side only)
GEMINI_API_KEY=

# Optional data.gov.in supplementary adapter
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=

# Seed script only — never commit real production passwords
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
